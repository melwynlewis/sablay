---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageCta from '@/components/PageCta.astro';
const team = [
  { name: 'First Name Last Name' },
  { name: 'First Name Last Name' },
  { name: 'First Name Last Name' },
  { name: 'First Name Last Name' },
];
---
<BaseLayout title="About Sablay | IT Consulting in Brussels" description="Meet Sablay, an IT consulting company based in Brussels, Belgium." type="website">
  <section class="bg-background py-section" data-ps="src/pages/about.astro:518k98"><div class="mx-auto max-w-7xl px-gutter" data-ps="src/pages/about.astro:txwtwn"><h1 class="text-h1 font-bold" data-ps="src/pages/about.astro:h98bko">About Sablay</h1><p class="mt-6 max-w-3xl text-lead text-muted-foreground" data-ps="src/pages/about.astro:uw7ia">An IT consulting company based in Brussels, Belgium, serving businesses of all sizes, from enterprise to small business.</p></div></section>
  <section class="bg-surface py-section" data-ps="src/pages/about.astro:ks8f5o"><div class="mx-auto grid max-w-7xl items-center gap-10 px-gutter md:grid-cols-2 md:gap-14" data-ps="src/pages/about.astro:txwtwo"><div data-ps="src/pages/about.astro:txwtwp"><h2 class="text-h2 font-bold" data-ps="src/pages/about.astro:2kted1">Bridging business and IT</h2><p class="mt-5 text-lead text-muted-foreground" data-ps="src/pages/about.astro:uw7i9">Good technology starts with understanding the people and processes it needs to support. Sablay brings business needs and specialist IT expertise together to turn challenges into practical solutions.</p><p class="mt-4 text-lead text-muted-foreground" data-ps="src/pages/about.astro:uw7i8">Our mission is to bridge the gap between business and IT with niche services and solutions, delivered with a shorter turnaround time.</p></div><img src="https://images.pexels.com/photos/7212946/pexels-photo-7212946.jpeg?auto=compress&cs=tinysrgb&w=1200" alt="Professionals sharing ideas around laptops in an office" width="1200" height="800" loading="lazy" class="aspect-[5/3] w-full rounded-image object-cover" data-ps="src/pages/about.astro:2ajx6t" /></div></section>
  <section class="bg-background py-section" data-ps="src/pages/about.astro:ks8f5p"><div class="mx-auto max-w-7xl px-gutter" data-ps="src/pages/about.astro:txwtwq"><h2 class="text-h2 font-bold" data-ps="src/pages/about.astro:2kted2">The people behind Sablay</h2><p class="mt-4 max-w-2xl text-lead text-muted-foreground" data-ps="src/pages/about.astro:uw7i7">Decades of collective experience across architecture, development, infrastructure and security.</p><div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4" data-ps="src/pages/about.astro:txwtwr">{team.map((member) => <article class="rounded-shape border border-border bg-surface p-7" data-ps="src/pages/about.astro:735k31"><div class="mx-auto flex aspect-square w-full items-center justify-center rounded-image bg-muted" aria-hidden="true" data-ps="src/pages/about.astro:txwtwt"><svg viewBox="0 0 120 120" class="h-3/5 w-3/5 text-muted-foreground" fill="currentColor"><circle cx="60" cy="42" r="22" /><path d="M20 112c0-22 18-40 40-40s40 18 40 40z" /></svg></div><h3 class="mt-6 text-h3 font-semibold" data-ps="src/pages/about.astro:c3liuk">{member.name}</h3></article>)}</div></div></section>
  <section class="bg-surface py-section" data-ps="src/pages/about.astro:ks8f5q"><div class="mx-auto grid max-w-7xl items-center gap-10 px-gutter md:grid-cols-2 md:gap-14" data-ps="src/pages/about.astro:txwtws"><div data-ps="src/pages/about.astro:txwtwt"><h2 class="text-h2 font-bold" data-ps="src/pages/about.astro:2kted3">Based in Brussels</h2><p class="mt-5 text-lead text-muted-foreground" data-ps="src/pages/about.astro:uw7i5">Brussels, Belgium</p><p class="mt-4 text-lead text-muted-foreground" data-ps="src/pages/about.astro:uw7hj">Serving clients onsite, nearshore and offshore.</p></div><img src="https://images.pexels.com/photos/38407395/pexels-photo-38407395.jpeg?auto=compress&cs=tinysrgb&w=1200" alt="Historic and modern architecture in Brussels" width="1200" height="800" loading="lazy" class="aspect-[2/1] w-full rounded-image object-cover" data-ps="src/pages/about.astro:2ajx6u" /></div></section>
  <PageCta title="Let us talk about your project" text="Meet the team that will work with you." dark={true} />
</BaseLayout>
