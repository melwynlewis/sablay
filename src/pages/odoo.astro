---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageCta from '@/components/PageCta.astro';
const steps = [
  { title: 'Discover', text: 'We learn your processes, pain points and goals.' },
  { title: 'Design', text: 'We map Odoo to your workflows and plan the scope.' },
  { title: 'Build and implement', text: 'Configuration, custom development and data migration.' },
  { title: 'Launch and support', text: 'Training, go-live and ongoing improvements.' },
];
---
<BaseLayout title="Odoo | Sablay" description="Odoo implementation and custom development built around your business." type="website">
  <section class="bg-background py-section" data-ps="src/pages/odoo.astro:mnsen4">
    <div class="mx-auto grid max-w-7xl items-center gap-10 px-gutter lg:grid-cols-2 lg:gap-14" data-ps="src/pages/odoo.astro:6j5r2r">
      <div class="min-w-0" data-ps="src/pages/odoo.astro:6j5r2s"><h1 class="text-h1 font-bold" data-ps="src/pages/odoo.astro:gi1n3f">Odoo, built around your business</h1><p class="mt-6 text-lead text-muted-foreground" data-ps="src/pages/odoo.astro:fp461d">Custom development and implementation, so Odoo fits the way you work instead of the other way round.</p><a href="/book-a-consultation" class="mt-8 inline-flex rounded-button bg-primary px-7 py-4 font-semibold text-primary-foreground no-underline hover:bg-primary-hover" data-ps="src/pages/odoo.astro:mt22r5">Book an Odoo Consultation</a></div>
      <img src="https://images.pexels.com/photos/7698886/pexels-photo-7698886.jpeg?auto=compress&cs=tinysrgb&w=1200" alt="Colleagues reviewing business information on a laptop" width="1200" height="800" fetchpriority="high" class="aspect-[5/3] w-full rounded-image object-cover" data-ps="src/pages/odoo.astro:d3myso" />
    </div>
  </section>
  <section class="bg-surface py-section" data-ps="src/pages/odoo.astro:hll17c"><div class="mx-auto max-w-7xl px-gutter" data-ps="src/pages/odoo.astro:6j5r2t">
    <h2 class="text-h2 font-bold" data-ps="src/pages/odoo.astro:1tmpvs">Two ways we work with Odoo</h2>
    <div class="mt-10 grid gap-6 md:grid-cols-2" data-ps="src/pages/odoo.astro:6j5r2u">
      <article class="rounded-shape border border-border bg-background p-8" data-ps="src/pages/odoo.astro:oppegw"><h3 class="text-h3 font-semibold" data-ps="src/pages/odoo.astro:cus7cg">Implementation</h3><p class="mt-4 text-foreground" data-ps="src/pages/odoo.astro:fp461e">From first workshop to go-live.</p><ul class="mt-5 list-disc space-y-2 pl-5"><li data-ps="src/pages/odoo.astro:2klmct">Discovery and requirements</li><li data-ps="src/pages/odoo.astro:2klmcu">Configuration and data migration</li><li data-ps="src/pages/odoo.astro:2klmcv">Training and go-live support</li></ul></article>
      <article class="rounded-shape border border-border bg-background p-8" data-ps="src/pages/odoo.astro:oppegx"><h3 class="text-h3 font-semibold" data-ps="src/pages/odoo.astro:cus7cf">Custom development</h3><p class="mt-4 text-foreground" data-ps="src/pages/odoo.astro:fp461f">Extend Odoo where the standard setup stops.</p><ul class="mt-5 list-disc space-y-2 pl-5"><li data-ps="src/pages/odoo.astro:2klmcw">Custom modules and workflows</li><li data-ps="src/pages/odoo.astro:2klmcx">Integrations with your other systems</li><li data-ps="src/pages/odoo.astro:2klmcy">Ongoing enhancements</li></ul></article>
    </div>
  </div></section>
  <section class="bg-background py-section" data-ps="src/pages/odoo.astro:hll17b"><div class="mx-auto max-w-7xl px-gutter" data-ps="src/pages/odoo.astro:6j5r2v"><h2 class="text-h2 font-bold" data-ps="src/pages/odoo.astro:1tmpvt">From idea to go-live</h2><ol class="mt-10 grid list-none gap-6 p-0 sm:grid-cols-2 lg:grid-cols-4">{steps.map((step, index) => <li class="rounded-shape border border-border bg-surface p-7" data-ps="src/pages/odoo.astro:2klmdk"><span class="font-display text-2xl font-bold text-primary" data-ps="src/pages/odoo.astro:cpkj4m">{index + 1}</span><h3 class="mt-4 text-h3 font-semibold" data-ps="src/pages/odoo.astro:cus7bt">{step.title}</h3><p class="mt-3 text-foreground" data-ps="src/pages/odoo.astro:fp461g">{step.text}</p></li>)}</ol></div></section>
  <section class="bg-surface py-section" data-ps="src/pages/odoo.astro:hll17a"><div class="mx-auto grid max-w-7xl items-center gap-10 px-gutter md:grid-cols-2 md:gap-14" data-ps="src/pages/odoo.astro:6j5r2w"><div data-ps="src/pages/odoo.astro:6j5r2x"><h2 class="text-h2 font-bold" data-ps="src/pages/odoo.astro:1tmpvu">Teams outgrowing spreadsheets and disconnected tools</h2><p class="mt-5 text-lead text-muted-foreground" data-ps="src/pages/odoo.astro:fp461h">Odoo can help growing businesses bring sales, operations and reporting together. We help you choose the right starting point and adapt the system to your processes.</p></div><img src="https://images.pexels.com/photos/7439127/pexels-photo-7439127.jpeg?auto=compress&cs=tinysrgb&w=1200" alt="Project management software displayed on a laptop" width="1200" height="800" loading="lazy" class="aspect-[2/1] w-full rounded-image object-cover" data-ps="src/pages/odoo.astro:d3mysn" /></div></section>
  <PageCta title="Planning an Odoo project?" text="Tell us where you are and we will suggest the next step." dark={true} />
</BaseLayout>
