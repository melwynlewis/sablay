---
// Services overview: seven service cards and a contact prompt
const serviceLinks = ['/services#architecture', '/services#development', '/services#infrastructure', '/services#security', '/services#transformation', '/services#web-mobile', '/odoo'];
const svgOpen = '<svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">';
const services = [
  { title: 'Architecture & Design', text: 'Solution and system architecture that fits your business goals and scales with them.', icon: svgOpen + '<circle cx="12" cy="12" r="10"></circle><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon></svg>' },
  { title: 'Development', text: 'Custom software built to specification, from internal tools to full platforms.', icon: svgOpen + '<polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>' },
  { title: 'Infrastructure Support', text: 'Reliable day-to-day support for your servers, cloud and networks.', icon: svgOpen + '<rect x="2" y="2" width="20" height="8" rx="2"></rect><rect x="2" y="14" width="20" height="8" rx="2"></rect><line x1="6" y1="6" x2="6.01" y2="6"></line><line x1="6" y1="18" x2="6.01" y2="18"></line></svg>' },
  { title: 'Cyber Security', text: 'Assess, harden and monitor to keep your systems and data protected.', icon: svgOpen + '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>' },
  { title: 'Digital Transformation', text: 'Modernise processes and systems so your teams move faster.', icon: svgOpen + '<path d="M21 12a9 9 0 0 1-15.5 6.2L3 16"></path><path d="M3 12a9 9 0 0 1 15.5-6.2L21 8"></path><polyline points="21 3 21 8 16 8"></polyline><polyline points="3 21 3 16 8 16"></polyline></svg>' },
  { title: 'Web & Mobile App Development', text: 'Websites and apps designed and built for your customers and teams.', icon: svgOpen + '<rect x="5" y="2" width="14" height="20" rx="2"></rect><line x1="12" y1="18" x2="12.01" y2="18"></line></svg>' },
  { title: 'Odoo', text: 'Custom development and implementation around the way you work.', icon: svgOpen + '<polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>' },
];
---

<section id="services" class="scroll-mt-20 bg-background py-section" data-ps="src/components/home/Services.astro:dod6cb">
  <div class="mx-auto max-w-7xl px-gutter" data-ps="src/components/home/Services.astro:8cm2gs">
    <h2 class="text-h2 font-bold text-foreground" data-ps="src/components/home/Services.astro:j6q9bc">What we do</h2>
    <p class="mt-4 text-lead text-muted-foreground" data-ps="src/components/home/Services.astro:vqhksj">Seven focused services covering design, build, run and protect.</p>

    <ul class="mt-12 grid list-none grid-cols-1 gap-6 p-0 sm:grid-cols-2 lg:grid-cols-4">
      {services.map((service, __psIdx) => (
        <li data-ps={`src/components/home/Services.astro:raohi9-${__psIdx}`}>
          <article class="flex h-full flex-col gap-4 rounded-shape border border-border bg-surface p-6" data-ps={`src/components/home/Services.astro:g1l4y1-${__psIdx}`}>
            <span class="flex size-12 items-center justify-center rounded-button bg-background text-primary" set:html={service.icon} data-ps={`src/components/home/Services.astro:4ny1x7-${__psIdx}`}></span>
            <h3 class="text-h3 font-semibold text-foreground" data-ps={`src/components/home/Services.astro:ipom6e-${__psIdx}`}>{service.title}</h3>
            <p class="text-muted-foreground" data-ps={`src/components/home/Services.astro:vqhksi-${__psIdx}`}>{service.text}</p>
            <a href={serviceLinks[__psIdx]} class="mt-auto font-semibold text-primary no-underline hover:text-primary-hover" data-ps={`src/components/home/Services.astro:hqdryj-${__psIdx}`}>Learn more →</a>
          </article>
        </li>
      ))}
      <li data-ps="src/components/home/Services.astro:raohia">
        <article class="flex h-full flex-col gap-4 rounded-shape border border-dashed border-primary/40 bg-background p-6" data-ps="src/components/home/Services.astro:g1l4y0">
          <h3 class="text-h3 font-semibold text-foreground" data-ps="src/components/home/Services.astro:ipom6f">Not sure what you need?</h3>
          <p class="text-muted-foreground" data-ps="src/components/home/Services.astro:vqhksh">Tell us the problem. We will point you to the right service.</p>
          <a href="/book-a-consultation" class="mt-auto inline-flex w-fit items-center rounded-button bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground no-underline transition-colors hover:bg-primary-hover" data-ps="src/components/home/Services.astro:hqdryk">Talk to an expert</a>
        </article>
      </li>
    </ul>
  </div>
</section>
